# Copy to server/.env and fill in. Every value is optional in development.

# production | development
NODE_ENV=development
PORT=4000

# Long random string. REQUIRED in production (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`).
JWT_SECRET=

# Public address of the website. Used for Google (canonical links, sitemap) and Paystack callbacks.
# Development: http://localhost:5173   Production: https://www.frogrillsxperience.com
SITE_URL=http://localhost:5173

# Paystack secret key (sk_test_... or sk_live_...). Leave empty to hide "Pay online" at checkout.
# In the Paystack dashboard set the webhook URL to  <SITE_URL>/api/public/payments/paystack/webhook
PAYSTACK_SECRET_KEY=

# Set to 1 when running behind a reverse proxy / load balancer (Render, Railway, Nginx) so rate limits see real IPs.
TRUST_PROXY=

# Where data lives. Point these at a persistent disk in production.
# DB_PATH=./data/fro-grills-xperience.db
# UPLOAD_DIR=./uploads

# First owner account created by `npm run seed` (a random password is printed if unset).
OWNER_NAME=Fro Grills Xperience Owner
OWNER_EMAIL=owner@frogrillsxperience.com
OWNER_PASSWORD=
