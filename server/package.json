    "backup": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/db/backup.js",
    "test": "node --disable-warning=ExperimentalWarning --test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "zod": "^4.6.5"
